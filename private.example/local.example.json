{
  "timezone": "Area/City",
  "profile": {
    "workWindows": [
      { "start": "09:00", "end": "12:00" },
      { "start": "13:00", "end": "18:00" }
    ],
    "protectedBlocks": [
      { "name": "lunch", "start": "12:00", "end": "13:00" }
    ]
  },
  "travel": {
    "bufferMinutes": 30,
    "virtualLocationPatterns": ["zoom.us", "teams.microsoft", "meet.google", "https://"]
  },
  "sources": {
    "horizonDays": 14,
    "maxLookbackDays": 7,
    "gmail": {
      "enabled": false,
      "mode": "label_only",
      "labelIds": [],
      "excludeCategories": ["promotions", "social"]
    },
    "slack": {
      "enabled": false,
      "calendarNotificationApps": ["Google Calendar", "Outlook Calendar"],
      "highSignalChannels": [],
      "prioritize": ["dms", "mentions", "threads", "calendar_notifications"]
    },
    "calendars": {
      "google": {
        "enabled": true,
        "mode": "direct",
        "calendars": [
          {
            "name": "school",
            "id": "replace-with-calendar-id",
            "role": ["fixed_events"]
          },
          {
            "name": "planning",
            "id": "replace-with-planning-calendar-id",
            "role": ["planning_dedupe"]
          }
        ]
      },
      "outlook": {
        "enabled": false,
        "mode": "direct",
        "calendarIds": [],
        "returnsWallClockAsUtc": false
      }
    },
    "checklistSources": [
      {
        "id": "course-checklist-1",
        "label": "Course Name",
        "type": "manual",
        "locator": {},
        "completionRule": "Checkbox checked means complete; unchecked means pending."
      }
    ],
    "activeProject": {
      "enabled": true,
      "provider": "local_git",
      "primary": {
        "repo": "owner/repository",
        "localPath": "/absolute/path/to/primary-repo",
        "label": "ProjectName"
      },
      "secondary": [],
      "nextStepSources": ["session_report", "project_notes", "recent_commits"]
    },
    "projectMapping": [
      {
        "localPath": "/absolute/path/to/primary-repo",
        "project": "ProjectName"
      }
    ],
    "jobDeadlines": {
      "enabled": false,
      "calendarIds": [],
      "confidenceMarkers": []
    }
  },
  "naming": {
    "template": "{typeEmoji} [{project}] {verb}: {object}",
    "dedupeAnchor": "project + start time",
    "typeEmoji": {
      "analysis": "🔬",
      "writing": "✍️",
      "reading": "📚",
      "chore": "🔧"
    }
  },
  "focusHours": {
    "strategy": ["worklog_calendars", "git_commits", "ask_user"],
    "worklogCalendarIds": [],
    "alwaysConfirm": true
  },
  "destinations": {
    "dailyPlan": {
      "enabled": true,
      "databaseId": "replace-with-private-database-id",
      "dataSourceUrl": "collection://replace-with-data-source-uuid"
    },
    "dailyJournal": {
      "enabled": true,
      "databaseId": "replace-with-private-database-id",
      "dataSourceUrl": "collection://replace-with-data-source-uuid"
    },
    "planningCalendar": {
      "enabled": true,
      "calendarId": "replace-with-planning-calendar-id",
      "writePolicy": "confirmed_only",
      "dedupeBy": "read_destination"
    },
    "privateReadOnly": []
  }
}
